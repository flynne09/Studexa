rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacherFolder(teacherId) {
      return isSignedIn() && request.auth.uid == teacherId;
    }

    match /uploads/{teacherId}/{materialId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == teacherId);
      allow write: if isTeacherFolder(teacherId)
                   && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isTeacherFolder(teacherId);
    }
  }
}
